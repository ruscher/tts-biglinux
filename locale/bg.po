#: usr/share/biglinux/tts-biglinux/services/package_installer.py:177
msgid "The installation was cancelled: the administrator password was not confirmed."
msgstr "Инсталацията беше отменена: паролата на администратора не беше потвърдена."

#: usr/share/biglinux/tts-biglinux/services/package_installer.py:180
#: usr/share/biglinux/tts-biglinux/services/package_installer.py:239
#, python-brace-format
msgid "{packages} is not available in your repositories. Update the system (sudo pacman -Syu) and try again."
msgstr "{packages} не е наличен във вашите хранилища. Обновете системата (sudo pacman -Syu) и опитайте отново."

#: usr/share/biglinux/tts-biglinux/services/package_installer.py:184
