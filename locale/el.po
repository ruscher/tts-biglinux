#: usr/share/biglinux/tts-biglinux/services/package_installer.py:177
msgid "The installation was cancelled: the administrator password was not confirmed."
msgstr "Η εγκατάσταση ακυρώθηκε: ο κωδικός πρόσβασης διαχειριστή δεν επιβεβαιώθηκε."

#: usr/share/biglinux/tts-biglinux/services/package_installer.py:180
#: usr/share/biglinux/tts-biglinux/services/package_installer.py:239
#, python-brace-format
msgid "{packages} is not available in your repositories. Update the system (sudo pacman -Syu) and try again."
msgstr "Το {packages} δεν είναι διαθέσιμο στα αποθετήριά σας. Ενημερώστε το σύστημα (sudo pacman -Syu) και δοκιμάστε ξανά."

#: usr/share/biglinux/tts-biglinux/services/package_installer.py:184
#: usr/share/biglinux/tts-biglinux/services/package_installer.py:204
#: usr/share/biglinux/tts-biglinux/services/package_installer.py:244
#: usr/share/biglinux/tts-biglinux/services/package_installer.py:263
msgid "Another program is installing or updating packages. Wait for it to finish and try again."
msgstr "Ένα άλλο πρόγραμμα εγκαθιστά ή ενημερώνει πακέτα. Περιμένετε να ολοκληρωθεί και δοκιμάστε ξανά."

#: usr/share/biglinux/tts-biglinux/services/package_installer.py:186
msgid "The packages could not be downloaded. Check your internet connection and try again."
msgstr "Δεν ήταν δυνατή η λήψη των πακέτων. Ελέγξτε τη σύνδεσή σας στο διαδίκτυο και δοκιμάστε ξανά."

#: usr/share/biglinux/tts-biglinux/services/package_installer.py:188
#, python-brace-format
msgid "{packages} conflicts with installed files or packages. See the details."
msgstr "Το {packages} συγκρούεται με εγκατεστημένα αρχεία ή πακέτα. Δείτε τις λεπτομέρειες."

#: usr/share/biglinux/tts-biglinux/services/package_installer.py:190
#, python-brace-format
msgid "Not enough free disk space to install {packages}."
msgstr "Δεν υπάρχει αρκετός ελεύθερος χώρος στον δίσκο για την εγκατάσταση του {packages}."

#: usr/share/biglinux/tts-biglinux/services/package_installer.py:192
#, python-brace-format
msgid "{packages} could not be installed. See the details."
msgstr "Δεν ήταν δυνατή η εγκατάσταση του {packages}. Δείτε τις λεπτομέρειες."

#: usr/share/biglinux/tts-biglinux/services/package_installer.py:200
#: usr/share/biglinux/tts-biglinux/services/package_installer.py:236
msgid "Nothing to install."
msgstr "Δεν υπάρχει τίποτα για εγκατάσταση."

#: usr/share/biglinux/tts-biglinux/services/package_installer.py:213
msgid "pkexec is not installed (package polkit)."
msgstr "Το pkexec δεν είναι εγκατεστημένο (πακέτο polkit)."

#: usr/share/biglinux/tts-biglinux/services/package_installer.py:215
#: usr/share/biglinux/tts-biglinux/services/package_installer.py:218
#: usr/share/biglinux/tts-biglinux/services/package_installer.py:255
msgid "The installation took too long and was stopped."
msgstr "Η εγκατάσταση διήρκεσε πολύ και διακόπηκε."

#: usr/share/biglinux/tts-biglinux/services/package_installer.py:252
#: usr/share/biglinux/tts-biglinux/services/package_installer.py:265
