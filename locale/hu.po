#, python-brace-format
msgid "{packages} is not available in your repositories. Update the system (sudo pacman -Syu) and try again."
msgstr "A(z) {packages} nem érhető el a tárolókban. Frissítse a rendszert (sudo pacman -Syu), és próbálja újra."

