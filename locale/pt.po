#: usr/share/biglinux/tts-biglinux/services/shortcut_service.py:127
msgid "This key combination is not valid."
msgstr "Esta combinação de teclas não é válida."

#: usr/share/biglinux/tts-biglinux/services/shortcut_service.py:134
