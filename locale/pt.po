#: usr/share/biglinux/tts-biglinux/application.py:893
msgid "BigLinux Team"
msgstr "Equipa BigLinux"

#: usr/share/biglinux/tts-biglinux/application.py:904
msgid "BigLinux TTS turns selected or typed text into speech with local voices, global shortcuts and precise playback controls."
msgstr "O BigLinux TTS transforma texto selecionado ou escrito em fala, com vozes locais, atalhos globais e controlos de reprodução precisos."

#: usr/share/biglinux/tts-biglinux/application.py:907
msgid "BigLinux TTS began as a web-based tool in 2021 and evolved into a native GTK4 application with multiple speech engines, voice management and a Rust audio engine."
msgstr "O BigLinux TTS começou em 2021 como uma ferramenta web e evoluiu para uma aplicação GTK4 nativa, com vários motores de voz, gestão de vozes e um motor de áudio em Rust."

#: usr/share/biglinux/tts-biglinux/application.py:959
msgid "Could not register the shortcut."
msgstr "Não foi possível registar o atalho."

#: usr/share/biglinux/tts-biglinux/application.py:985
#, python-brace-format
msgid "Select text and press {shortcut} to hear it"
msgstr "Selecione um texto e prima {shortcut} para o ouvir"

#: usr/share/biglinux/tts-biglinux/application.py:986
msgid "Text-to-speech assistant"
msgstr "Assistente de texto para fala"

#: usr/share/biglinux/tts-biglinux/main.py:24
msgid "BigLinux Text-to-Speech — Read selected text aloud"
msgstr "BigLinux Text-to-Speech — Leia em voz alta o texto selecionado"

#: usr/share/biglinux/tts-biglinux/main.py:29
msgid "Enable debug logging"
msgstr "Ativar registo de depuração"

#: usr/share/biglinux/tts-biglinux/main.py:40
msgid "Show how the shortcut, text capture, tray icon, voices and audio are set up, then exit"
msgstr "Mostra como estão configurados o atalho, a captura de texto, o ícone da bandeja, as vozes e o áudio, e sai"

#: usr/share/biglinux/tts-biglinux/main.py:45
msgid "Register the global shortcut again on this desktop, then exit"
msgstr "Regista de novo o atalho global neste ambiente e sai"

#: usr/share/biglinux/tts-biglinux/main.py:50
msgid "Remove the shortcut this app added to Big WindowMaker, then exit"
msgstr "Remove o atalho que este aplicativo adicionou ao Big WindowMaker e sai"

