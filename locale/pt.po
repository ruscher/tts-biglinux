msgstr "O ambiente de trabalho não aceitou o atalho. O serviço de atalhos globais do KDE está em execução?"

#: usr/share/biglinux/tts-biglinux/services/shortcut_service.py:272
msgid "The desktop did not confirm the new shortcut."
msgstr "O ambiente de trabalho não confirmou o novo atalho."

#: usr/share/biglinux/tts-biglinux/services/shortcut_service.py:292
#, python-brace-format
msgid "{shortcut} is saved. It starts working after you log in again."
msgstr "{shortcut} foi guardado. Passa a funcionar depois de iniciar sessão novamente."

#: usr/share/biglinux/tts-biglinux/services/shortcut_service.py:303
#, python-brace-format
msgid "The shortcut could not be added automatically. Add this line to KeyBindings in {file}: {line}"
