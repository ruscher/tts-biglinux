msgstr "Outro programa está a instalar ou atualizar pacotes. Aguarde que termine e tente novamente."

#: usr/share/biglinux/tts-biglinux/services/package_installer.py:186
msgid "The packages could not be downloaded. Check your internet connection and try again."
msgstr "Não foi possível transferir os pacotes. Verifique a ligação à internet e tente novamente."

#: usr/share/biglinux/tts-biglinux/services/package_installer.py:188
#, python-brace-format
msgid "{packages} conflicts with installed files or packages. See the details."
msgstr "{packages} entra em conflito com ficheiros ou pacotes instalados. Veja os detalhes."

#: usr/share/biglinux/tts-biglinux/services/package_installer.py:190
#, python-brace-format
msgid "Not enough free disk space to install {packages}."
msgstr "Não há espaço livre suficiente em disco para instalar {packages}."

#: usr/share/biglinux/tts-biglinux/services/package_installer.py:192
#, python-brace-format
msgid "{packages} could not be installed. See the details."
msgstr "Não foi possível instalar {packages}. Veja os detalhes."

