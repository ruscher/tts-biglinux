#, python-brace-format
msgid "{engine} could not start. Check that it is installed."
msgstr "Não foi possível iniciar o {engine}. Verifique se está instalado."

#: usr/share/biglinux/tts-biglinux/services/tts_service.py:650
msgid "RHVoice is not installed. Install the rhvoice package."
msgstr "O RHVoice não está instalado. Instale o pacote rhvoice."

#: usr/share/biglinux/tts-biglinux/services/tts_service.py:918
msgid "espeak-ng could not read this text. Check that espeak-ng is installed."
msgstr "O espeak-ng não conseguiu ler este texto. Verifique se o espeak-ng está instalado."

#: usr/share/biglinux/tts-biglinux/services/tts_service.py:933
